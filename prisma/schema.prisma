generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================
// USERS & AUTH
// ============================
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          String    @default("STAFF")
  avatarUrl     String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  allocationsCreated  DailyAllocation[] @relation("AllocationCreator")
  allocationsClosed   DailyAllocation[] @relation("AllocationCloser")
  paymentsRecorded    Payment[]         @relation("PaymentRecorder")
  stockMovements      StockMovement[]   @relation("StockRecorder")
  auditLogs           AuditLog[]
  pricePeriodsCreated PricePeriod[]     @relation("PricePeriodCreator")

  @@map("users")
}

// ============================
// DRIVERS
// ============================
model Driver {
  id            String    @id @default(cuid())
  code          String    @unique // e.g., "DRV-001"
  name          String
  phone         String    @unique
  photoUrl      String?
  joiningDate   DateTime
  vehicleNumber String?
  vehicleType   String?   // "TATA ACE", "MAHINDRA", etc.
  licenseNumber String?
  licenseExpiry DateTime?
  isActive      Boolean   @default(true)
  duesThreshold Int       @default(5000) // alert threshold in ₹
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  allocations   DailyAllocation[]
  payments      Payment[]
  deliveryProofs DeliveryProof[]

  @@map("drivers")
}

// ============================
// PRICING HISTORY
// ============================
model PricePeriod {
  id            String   @id @default(cuid())
  effectiveFrom DateTime
  cylinderPrice Int      // in paise (₹917 = 91700)
  costPrice     Int      // in paise
  margin        Int      // in paise (derived: cylinderPrice - costPrice)
  notes         String?
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())
  createdById   String
  createdBy     User     @relation("PricePeriodCreator", fields: [createdById], references: [id])

  @@index([effectiveFrom])
  @@map("price_periods")
}

// ============================
// DAILY ALLOCATION & DELIVERY
// ============================
model DailyAllocation {
  id                     String   @id @default(cuid())
  driverId               String
  driver                 Driver   @relation(fields: [driverId], references: [id])
  date                   DateTime
  
  // Morning issuance
  fullCylindersIssued    Int      @default(30)
  
  // Evening return
  fullCylindersSold      Int      @default(0)
  fullCylindersReturned  Int      @default(0)
  emptyCylindersCollected Int     @default(0)
  
  // Computed
  expectedCash           Int      // fullCylindersSold × price on that date
  status                 String   @default("PENDING")
  
  // Audit
  createdById            String
  createdBy              User     @relation("AllocationCreator", fields: [createdById], references: [id])
  createdAt              DateTime @default(now())
  closedAt               DateTime?
  closedById             String?
  closedBy               User?    @relation("AllocationCloser", fields: [closedById], references: [id])

  payments               Payment[]
  deliveryProofs         DeliveryProof[]

  @@unique([driverId, date])
  @@index([date])
  @@index([status])
  @@map("daily_allocations")
}

// ============================
// PAYMENTS
// ============================
model Payment {
  id            String   @id @default(cuid())
  driverId      String
  driver        Driver   @relation(fields: [driverId], references: [id])
  allocationId  String?
  allocation    DailyAllocation? @relation(fields: [allocationId], references: [id])
  date          DateTime
  amount        Int      // in paise
  method        String   @default("CASH")
  notes         String?
  recordedById  String
  recordedBy    User     @relation("PaymentRecorder", fields: [recordedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([driverId, date])
  @@index([allocationId])
  @@map("payments")
}

// ============================
// STOCK MOVEMENTS (FULL + EMPTY)
// ============================
model StockMovement {
  id              String        @id @default(cuid())
  type            String        // FULL or EMPTY
  movementType    String        // ISSUED_TO_DRIVER, RETURNED_FROM_DRIVER, REFILL_RECEIVED, MANUAL_ADJUSTMENT, DAMAGED_LOST
  quantity        Int
  referenceId     String?       // allocationId, purchaseOrderId, etc.
  referenceType   String?       // "ALLOCATION", "PURCHASE", "MANUAL"
  date            DateTime
  notes           String?
  recordedById    String
  recordedBy      User          @relation("StockRecorder", fields: [recordedById], references: [id])
  createdAt       DateTime      @default(now())

  @@index([type, date])
  @@index([referenceId])
  @@map("stock_movements")
}

// ============================
// DELIVERY PROOF (OPTIONAL)
// ============================
model DeliveryProof {
  id            String   @id @default(cuid())
  allocationId  String
  allocation    DailyAllocation @relation(fields: [allocationId], references: [id])
  driverId      String
  driver        Driver   @relation(fields: [driverId], references: [id])
  customerName  String
  customerPhone String?
  photoUrl      String?
  signatureUrl  String?
  latitude      Float?
  longitude     Float?
  deliveredAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([allocationId])
  @@index([driverId, deliveredAt])
  @@map("delivery_proofs")
}

// ============================
// AUDIT LOG
// ============================
model AuditLog {
  id          String   @id @default(cuid())
  entityType  String   // "Driver", "DailyAllocation", "Payment", etc.
  entityId    String
  action      String   // "CREATE", "UPDATE", "DELETE", "CLOSE", "REOPEN"
  oldValues   String?  // JSON as string
  newValues   String?  // JSON as string
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ============================
// SETTINGS
// ============================
model Setting {
  id        String @id @default(cuid())
  key       String @unique
  value     String
  category  String @default("GENERAL")
  updatedAt DateTime @updatedAt

  @@map("settings")
}